# Copy to config.env and fill MQTT_PASSWORD, then `chmod 600 config.env`.
# MQTT_PASSWORD is the edge credential — the same value as
# media-stack/mqtt/secrets/MQTT_EDGE_PASSWORD.

MQTT_HOST=192.168.8.3
MQTT_PORT=1883
MQTT_USERNAME=edge-daniel-home
MQTT_PASSWORD=

# Topic root and this device's node id. The node id becomes the bus subtree
# (grow/daniel-home/quantum-sensor/#) AND the InfluxDB `node` tag — keep it stable.
MQTT_TOPIC_PREFIX=grow/daniel-home
NODE_ID=quantum-sensor

# Dr. Liu SDI-12->USB adapter serial port and the sensor's SDI-12 address.
SDI12_PORT=/dev/ttyUSB0
SDI12_ADDRESS=0

# How often to poll the sensor (seconds).
POLL_SECONDS=10

# Unit string stored on the PPFD entity (the recorder tags InfluxDB with it; the
# Light-page card displays its own µmol·m⁻²·s⁻¹ regardless).
PPFD_UNIT=µmol/s/m²
