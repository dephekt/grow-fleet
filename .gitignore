/.esphome/
/.platformio/
/devices/.esphome/
/devices/secrets.yaml
# ESPHome CLI regenerates this boilerplate on every run; its two rules are
# already covered by the /devices/ entries above.
/devices/.gitignore
/secrets.yaml
/dist/
*.log

# Python: uv virtualenv + pytest cache (created by `make test` / `uv run`)
/.venv/
/.pytest_cache/

# Arduino firmware: build tree + generated (secrets/version) headers + compiled LZSS lib
/arduino/.build/
arduino/*/arduino_secrets.h
arduino/*/fw_version.h
arduino/tools/lzss.so
arduino/tools/lzss.dylib
arduino/tools/__pycache__/
